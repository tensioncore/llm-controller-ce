# --------------------------------------------------
# LLM Controller CE - Git Ignore
# --------------------------------------------------

# Python bytecode / caches
__pycache__/
*.py[codz]
*$py.class

# Virtual environments
.env
.env.*
.envrc
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Python packaging / build output
.Python
build/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer / pip logs
pip-log.txt
pip-delete-this-directory.txt

# Test / coverage / tool caches
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache/
.pytest_cache/
.hypothesis/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
dmypy.json
.dmypy.json
coverage.xml
nosetests.xml
*.cover
*.py.cover
cover/

# Flask / app runtime caches
instance/
.webassets-cache

# Local SQLite / local DB artifacts
chats.sqlite
*.sqlite
*.sqlite3
*.db
*.db-journal
db.sqlite3
db.sqlite3-journal

# Logs
*.log
logs/
log/
runtime_logs/
*.out

# OS / editor junk
Thumbs.db
Desktop.ini
.DS_Store

# VS Code / IDE
.vscode/
.idea/
.spyderproject
.spyproject
.ropeproject

# Jupyter / IPython
.ipynb_checkpoints/
profile_default/
ipython_config.py

# Documentation build output
docs/_build/
site/

# Local upload / export / backup artifacts
exports/
backups/
tmp/
temp/
*.bak
*.tmp

# --------------------------------------------------
# LLM Controller CE specific
# --------------------------------------------------

# Local runtime config / secrets
bootstrap_config.json
bootstrap_config.py
flask_secret.key
settings.local.*
config.local.*
secrets.*
*.secret
*.key
*.pem

# Uploaded user files / attachments if stored locally
uploads/
user_uploads/
attachments/

# Chat exports / imports / generated archives
chat_exports/
chat_backups/
analytics_exports/

# Runtime-generated app data
data/
runtime/
sessions/

# Model storage / GGUFs / split model shards
models/
models/**/*.gguf
models/**/*.ggml
*.gguf
*.gguf.*
*.ggml
*.bin

# llama.cpp / llama-server local binaries or custom builds
llama-server/
llama.cpp/build/
llama-bin/
llama-runtime/

# NVIDIA / GPU dumps / local diagnostics
nvidia-smi.txt
gpu_debug/

# Batch / launcher local overrides
start_llm_controller.local.bat

# Optional local SQL dumps
*.sql.bak
*.dump

# Cursor / editor AI metadata
.cursorignore
.cursorindexingignore
.abstra/

# PEP 582 / alt envs
__pypackages__/
.pdm-python
.pdm-build/
.pixi/

# Optional lockfiles
# Uncomment if you do NOT want to track them
#Pipfile.lock
#poetry.lock
#uv.lock
#pdm.lock
#pixi.lock
